          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/overview",
              "concepts/paired-tokens",
              "concepts/nav",
              "concepts/markets",
              "concepts/oracle",
              "concepts/risk-states",
              "concepts/keeper",
              "concepts/clp",
              "concepts/solvency"
            ]
          },
          {
            "group": "Core flows",
            "pages": [
              "flows/mint",
              "flows/redeem",
              "flows/trade",
              "flows/read-state"
            ]
          },
          {
            "group": "Build on Continuum",
            "pages": [
              "build/sdk-setup",
              "build/idls-and-pdas",
              "build/example-mint-redeem",
