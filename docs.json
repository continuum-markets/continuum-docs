              "build/cpi",
              "build/composability"
            ]
          },
          {
            "group": "Markets",
            "pages": [
              "markets/live",
              "markets/listing",
              "markets/roadmap"
            ]
          },
          {
            "group": "Keeper & market making",
            "pages": [
              "keeper/overview",
              "keeper/arb-paths",
              "keeper/dlmm",
              "keeper/running"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
