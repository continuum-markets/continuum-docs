{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Continuum",
  "description": "24/7 synthetic exposure to real-world assets on Solana — developer documentation.",
  "colors": {
    "primary": "#7C3AED",
    "light": "#A78BFA",
    "dark": "#5B21B6"
